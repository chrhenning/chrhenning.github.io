{% comment %}
  Local override of al_folio_core's _layouts/distill.liquid: adds the newsletter
  JS (see below) and a Disclaimer in d-appendix. Re-sync against the gem on upgrade.
{% endcomment %}
{% assign distill_feature_enabled = site.al_folio.features.distill.enabled | default: true %}

{% if site.plugins contains 'al_folio_distill' and distill_feature_enabled %}
  {% al_folio_distill_render %}
  {% comment %}
    distill renders its own document and skips scripts.liquid, so inject the
    newsletter JS here (mirroring scripts.liquid's conditions).
  {% endcomment %}
  {% if site.newsletter.enabled and site.plugins contains 'al_newsletter' %}
    {% include plugins/al_newsletter_scripts.liquid %}
  {% endif %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var appendix = document.querySelector('d-appendix');
      if (!appendix || appendix.querySelector('.custom-disclaimer')) return;
      var heading = document.createElement('h3');
      heading.className = 'custom-disclaimer';
      heading.style.gridColumn = 'page-start / text-start';
      heading.textContent = 'Disclaimer';
      var body = document.createElement('p');
      body.className = 'custom-disclaimer';
      body.style.gridColumn = 'text';
      body.style.fontWeight = '500';
      body.style.color = 'inherit';
      body.textContent =
        'The views expressed are my own and do not represent those of any employer, collaborator, or institution. ' +
        'Content may contain errors or outdated interpretations.';
      appendix.insertBefore(body, appendix.firstChild);
      appendix.insertBefore(heading, appendix.firstChild);
    });
  </script>
{% else %}
  <!doctype html>
  <html lang="{{ site.lang }}">
    <head>
      {% include head.liquid %}
    </head>
    <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
      {% include header.liquid %}
      <div class="container mt-5" role="main">
        <h1>{{ page.title }}</h1>
        <p>Distill rendering is unavailable. Enable <code>al_folio_distill</code> and set <code>al_folio.features.distill.enabled: true</code>.</p>
      </div>
      {% include footer.liquid %}
      {% include scripts.liquid %}
    </body>
  </html>
{% endif %}
